# Copy this file to .env for local development. Never commit the real .env file.
NEWSDATA_API_KEY=replace_with_your_newsdata_key
AI_API_KEY=replace_with_your_gemini_key
GEMINI_MODEL=gemini-3.7-flash
SECRET_KEY=replace_with_a_long_random_secret
FLASK_DEBUG=1
SESSION_COOKIE_SECURE=0

# Local MySQL defaults. Railway supplies these through its MySQL service.
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=ewaste_db

# Railway volume example: /data/avatars
AVATAR_FOLDER=static/avatars
